  <Code>Public Function ConvertNumberToWord(nNumber As Long) As String

	Dim CurrentNumber As Long = nNumber

	Dim sReturn As String = ""

	If CurrentNumber &gt;= 1000000000 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber \ 1000000000, "Billion")


		CurrentNumber = CurrentNumber Mod 1000000000
	End If

	If CurrentNumber &gt;= 10000000 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber \ 10000000, "Crore")


		CurrentNumber = CurrentNumber Mod 10000000
	End If
	If CurrentNumber &gt;= 100000 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber \ 100000, "Lakhs")


		CurrentNumber = CurrentNumber Mod 100000
	End If

	If CurrentNumber &gt;= 1000 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber \ 1000, "Thousand")


		CurrentNumber = CurrentNumber Mod 1000
	End If

	If CurrentNumber &gt;= 100 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber \ 100, "Hundred")


		CurrentNumber = CurrentNumber Mod 100
	End If

	If CurrentNumber &gt;= 20 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber, "")


		CurrentNumber = CurrentNumber Mod 10

	ElseIf CurrentNumber &gt; 0 Then

		sReturn = sReturn &amp; " " &amp; GetWord(CurrentNumber, "")


		CurrentNumber = 0
	End If
If sReturn= "" Then

		sReturn ="Zero"

Else
	sReturn=sReturn.Replace(" ", " ").Trim()&amp; " Only"

End If
Return sReturn

End Function

Private Function GetWord(nNumber As Long, sPrefix As String) As String

	Dim nCurrentNumber As Long = nNumber

	Dim sReturn As String = ""

	While nCurrentNumber &gt; 0

		If nCurrentNumber &gt; 100 Then

			sReturn = sReturn &amp; " " &amp; GetWord(nCurrentNumber \ 100, "Hundred")


			nCurrentNumber = nCurrentNumber Mod 100

		ElseIf nCurrentNumber &gt; 20 Then

			sReturn = sReturn &amp; " " &amp; GetTwentyWord(nCurrentNumber \ 10)


			nCurrentNumber = nCurrentNumber Mod 10
		Else


			sReturn = sReturn &amp; " " &amp; GetLessThanTwentyWord(nCurrentNumber)


			nCurrentNumber = 0

		End If
	End While

	sReturn = sReturn &amp; " " &amp; sPrefix

	Return sReturn

End Function

Private Function GetTwentyWord(nNumber As Long) As String

	Dim sReturn As String = ""

	Select Case nNumber

		Case 2

			sReturn = "Twenty"

			Exit Select

		Case 3

			sReturn = "Thirty"

			Exit Select

		Case 4

			sReturn = "Forty"

			Exit Select

		Case 5

			sReturn = "Fifty"

			Exit Select

		Case 6

			sReturn = "Sixty"

			Exit Select

		Case 7

			sReturn = "Seventy"

			Exit Select

		Case 8

			sReturn = "Eighty"

			Exit Select

		Case 9

			sReturn = "Ninety"

			Exit Select

	End Select

	Return sReturn

End Function

Private Function GetLessThanTwentyWord(nNumber As Long) As String

	Dim sReturn As String = "and"

	Select Case nNumber

		Case 1

			sReturn = "One"

			Exit Select

		Case 2

			sReturn = "Two"

			Exit Select

		Case 3

			sReturn = "Three"

			Exit Select

		Case 4

			sReturn = "Four"

			Exit Select

		Case 5

			sReturn = "Five"

			Exit Select

		Case 6

			sReturn = "Six"

			Exit Select

		Case 7

			sReturn = "Seven"

			Exit Select

		Case 8

			sReturn = "Eight"

			Exit Select

		Case 9

			sReturn = "Nine"

			Exit Select

		Case 10

			sReturn = "Ten"

			Exit Select

		Case 11

			sReturn = "Eleven"

			Exit Select

		Case 12

			sReturn = "Twelve"

			Exit Select

		Case 13

			sReturn = "Thirteen"

			Exit Select

		Case 14

			sReturn = "Forteen"

			Exit Select

		Case 15

			sReturn = "Fifteen"

			Exit Select

		Case 16

			sReturn = "Sixteen"

			Exit Select

		Case 17

			sReturn = "Seventeen"

			Exit Select

		Case 18

			sReturn = "Eighteen"

			Exit Select

		Case 19

			sReturn = "Nineteen"

			Exit Select

	End Select

	Return sReturn

End Function


	
