div.content {
    clear: left;
	width:710px;
	height:480px;
    padding: 0em;
	margin-left:20px;
}

div.content.inactive {
	display: none;
}

ol#toc {
   height: 2.5em;
	width:62em;
    list-style: none;
    margin: 0;
    padding: 0;
}

ol#toc a {
    background: #2a2a2a url(images/tabs.gif);
	font-family:Arial, Helvetica, sans-serif;
	text-align:center;
	font-size:12px;
    color: #2b2b2b;
    display: block;
    float: left;
    height: 2.5em;
	width:8em;
    padding-left: 10px;
    text-decoration: none;
}

ol#toc a:hover {
   background-color: #3af;
    background-position: 0 -120px;
}

ol#toc a:hover span {
    background-position: 100% -120px;
}

ol#toc li {
    float: left;
    margin: 0 1px 0 0;
}

ol#toc li a.active {
    background-color: #48f;
    background-position: 0 -60px;
    color: #fff;
    font-weight: bold;
}

ol#toc li a.active span {
    background-position: 100% -60px;
}

ol#toc span {
    background: url(images/tabs.gif) 100% 0;
    display: block;
    line-height: 2em;
    padding-right: 10px;
}