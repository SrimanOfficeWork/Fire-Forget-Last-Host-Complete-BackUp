                                </div>
                                <div id="txtcon_m_src_new_Checklist">
                                </div>
                            </div>
                            <div id="tag_transac_lft_Checklist">
                                <div id="tag_label_transaction_popup_gen">
                                    Current Job</div>
                                <div id="txtcon_m_src_new_Checklist">
                                    <asp:TextBox ID="txtCurrent_Job" runat="server" MaxLength="40" ClientIDMode="Static"
