                    beDutyPaid = GetValue(r, "BE_DUTY_PAID"),
                    beDutyPaymentDate = GetValue(r, "BE_DUTY_PAYMENT_DATE"),

                    beOtherIdentifiableParameter = GetValue(r, "BE_OTH_IDENTIFIABLE_PARAMETER"),
                    beAssessableValueClaimed = GetValue(r, "BE_ASS_VALUE_CLAIM"),

                    beItemUsed = GetValue(r, "BE_ITEM_USED_Y_N"),
                    commisionerPermission = GetValue(r, "COMMISIONER_PERMISSION_Y_N"),
                    inputCredit = GetValue(r, "INPUT_CREDIT_Y_N"),
                    personalUse = GetValue(r, "PERSONAL_USED_Y_N"),

                    modvaAvailed = GetValue(r, "MODVAT_AVAILED_Y_N"),
                    modvatRepaid = GetValue(r, "MODVAT_REPAID_Y_N")
                };

                root.master_Exp.Reexport.Add(re);
            }
        }

        // ================= STATEMENT =================

        root.master_Exp.Statement = new List<StatementModel_Exp>();

        if (ds.Tables.Count > 19 && ds.Tables[19].Rows.Count > 0)
        {
            foreach (DataRow r in ds.Tables[19].Rows)
            {
                StatementModel_Exp stmt = new StatementModel_Exp
                {
                    jobNumber = GetValue(r, "JOBNO"),
                    invoiceSerialNumber = GetValue(r, "INVOICE_SLNO"),
                    itemSerialNumber = GetValue(r, "ITEM_SLNO"),
                    statementSerialNo = GetValue(r, "SLNO"),
                    statementType = GetValue(r, "STMT_TYPE"),
                    statementCode = GetValue(r, "STMT_CODE"),
                    statementText = GetValue(r, "STMT_TEXT")
                };

                root.master_Exp.Statement.Add(stmt);
            }
        }
        // ================= SUPPORTING DOCS =================

        root.master_Exp.SupportingDocs = new List<SupportingDocsModel_Exp>();

        if (ds.Tables.Count > 20 && ds.Tables[20].Rows.Count > 0)
        {
            foreach (DataRow row in ds.Tables[20].Rows)
            {
                SupportingDocsModel_Exp doc = new SupportingDocsModel_Exp
                {
                    messageType = "F",

                    jobNumber = GetValue(row, "JOBNO"),
                    jobDate = GetValue(masterRow, "JOBDATE"),

                    invoiceSerialNumber = GetValue(row, "INVOICE_SLNO"),
                    itemSerialNumber = GetValue(row, "ITEM_SLNO"),
                    serialNo = GetValue(row, "SLNO"),

                    imageReferenceNumber = GetValue(row, "UNIQUE_DOC_NUMBER"),
                    documentTypeCode = GetValue(row, "DOC_TYPE_CODE"),

                    documentIssuingPartyCode = GetValue(row, "DOC_ISSUING_PARTY_CODE"),
                    documentIssuingPartyName = GetValue(row, "DOC_ISSUING_PARTY_NAME"),
                    documentIssuingPartyNameAddress1 = GetValue(row, "DOC_ISSUING_PARTY_NAME_ADD1"),
                    documentIssuingPartyNameAddress2 = GetValue(row, "DOC_ISSUING_PARTY_NAME_ADD2"),
                    documentIssuingPartyNameCity = GetValue(row, "DOC_ISSUING_PARTY_CITY"),
                    documentIssuingPartyNamePin = GetValue(row, "DOC_ISSUING_PARTY_PIN"),

                    documentReferenceNo = GetValue(row, "DOC_REF_NUMBER"),
                    placeOfIssue = GetValue(row, "PLACE_OF_ISSUE"),
                    documentIssueDate = GetValue(row, "DOC_ISSUE_DATE"),
                    documentExpiryDate = GetValue(row, "DOC_EXPIRY_DATE"),

                    documentBeneficiaryPartyCode = GetValue(row, "BENEFICIARY_PARTY_CODE"),
                    documentBeneficiaryPartyName = GetValue(row, "BENEFICIARY_PARTY_NAME"),
                    documentBeneficiaryPartyNameAddress1 = GetValue(row, "BENEFICIARY_PARTY_ADDRESS1"),
                    documentBeneficiaryPartyNameAddress2 = GetValue(row, "BENEFICIARY_PARTY_ADDRESS2"),
                    documentBeneficiaryPartyNameCity = GetValue(row, "BENEFICIARY_PARTY_CITY"),
                    documentBeneficiaryPartyNamePin = GetValue(row, "BENEFICIARY_PARTY_PIN"),

                    fileType = GetValue(row, "FILE_TYPE"),
                    icegateId = GetValue(row, "ICEGATE_ID")
                };

                root.master_Exp.SupportingDocs.Add(doc);
            }
        }
        // ================= THIRD PARTY MODEL =================

        root.master_Exp.ThirdPartyModel = new List<ThirdPartyModel_Exp>();

        if (ds.Tables.Count > 5 && ds.Tables[5].Rows.Count > 0)
        {
            foreach (DataRow row in ds.Tables[5].Rows)
            {
                ThirdPartyModel_Exp third = new ThirdPartyModel_Exp
                {
                    messageType = "F",

                    jobNumber = GetValue(masterRow, "JOBNO"),
                    jobDate = GetValue(masterRow, "JOBDATE"),

                    invoiceSerialNumber = GetValue(row, "INVOICE_SLNO"),

                    // Not available in table → set NULL (NOT empty string)
                    itemSerialNumberInvoice = null,
                    iec = null,
                    branchSerialNo = null,

                    exporterName = GetValue(row, "THIRDPARTY_NAME"),
                    exporterAddress1 = GetValue(row, "THIRDPARTY_ADD1"),
                    exporterAddress2 = GetValue(row, "THIRDPARTY_ADD2"),
                    city = GetValue(row, "THIRDPARTY_CITY"),
                    pin = GetValue(row, "T_PARTY_PIN"),

                    amendmentType = null,
                    amendmentNumber = null,
                    amendmentDate = null,

                    gstnType = GetValue(row, "AUTHORIZED_ECONOMIC_OPERATOR"),
                    gstnId = GetValue(row, "AUTHORIZED_ECONOMIC_OPERATOR_CODE"),

                    itemThirdPartyValue = GetValue(row, "BUYER")
                };

                root.master_Exp.ThirdPartyModel.Add(third);
            }
        }
        // ================= DBKModel =================

        root.master_Exp.DBKModel = new List<DBKModel_Exp>();

        if (ds.Tables.Count > 8 && ds.Tables[8].Rows.Count > 0)
        {
            foreach (DataRow r in ds.Tables[8].Rows)
            {
                DBKModel_Exp DBK = new DBKModel_Exp
                {
                    invoiceSerialNumber = GetValue(r, "INVOICE_SLNO"),
                    itemSerialNumberInvoice = GetValue(r, "ITEM_SLNO"),
                    dbkScheduleNumber = GetValue(r, "DRAWBACK_SLNO"),
                    drawbackQuantity = GetValue(r, "DRAWBACK_QTY"),
                    drawbackAvailable = GetValue(r, "drawbackAvailable"),
                };

                root.master_Exp.DBKModel.Add(DBK);
            }
        }
        // ================= ExchangeModel  =================

        root.master_Exp.ExchangeModel = new List<ExchangeModel_Exp>();

        if (ds.Tables.Count > 5 && ds.Tables[5].Rows.Count > 0)
        {
            foreach (DataRow r in ds.Tables[5].Rows)
            {
                ExchangeModel_Exp ex = new ExchangeModel_Exp
                {
                    invoiceCurrencyCode = GetValue(r, "INVOICE_CURRENCY"),
                    unitInRs = GetValue(r, "EXCHANGE_RATE"),
                    rate = GetValue(r, "EXCHANGE_RATE"),
                    effectiveDate = GetValue(r, "effectiveDate"),
                    whetherStandardCurrency = GetValue(r, "standardCurrency"),
                };

                root.master_Exp.ExchangeModel.Add(ex);
            }
        }
        // ================= StuffModel=================

        root.master_Exp.StuffModel = new List<StuffModel>();

        if (ds.Tables.Count > 5 && ds.Tables[2].Rows.Count > 0)
        {
            foreach (DataRow st in ds.Tables[2].Rows)
            {
                StuffModel ex = new StuffModel
                {
                    factoryStuffed = GetValue(st, "ANNEX_SEA_FAC_STUFFED"),
                    sampleAccompanied = GetValue(st, "ANNEX_SEA_SAMPLE_ACCOM"),
                   
                };

                root.master_Exp.StuffModel.Add(ex);
            }
        }
        // ================= StuffModel=================

        root.master_Exp.StuffModel = new List<StuffModel>();

        if (ds.Tables.Count > 5 && ds.Tables[2].Rows.Count > 0)
        {
            foreach (DataRow st in ds.Tables[2].Rows)
            {
                StuffModel ex = new StuffModel
                {
                    factoryStuffed = GetValue(st, "ANNEX_SEA_FAC_STUFFED"),
                    sampleAccompanied = GetValue(st, "ANNEX_SEA_SAMPLE_ACCOM"),

                };

                root.master_Exp.StuffModel.Add(ex);
            }
        }
        // ================= RotationModel=================

        root.master_Exp.RotationModel = new List<RotationModel>();

        if (ds.Tables.Count > 5 && ds.Tables[2].Rows.Count > 0)
        {
            foreach (DataRow rt in ds.Tables[2].Rows)
            {
                RotationModel rm = new RotationModel
                {
                    rotationNumber = GetValue(rt, "ANNEX_AIR_ROTATION_NO"),
                    rotationDate = GetValue(rt, "ANNEX_AIR_ROTATION_DATE"),

                };

                root.master_Exp.RotationModel.Add(rm);
            }
        }
        // ================= CARGO BACK =================

        root.master_Exp.CargoBack = new List<CargoBackModel_Exp>();

        if (ds.Tables.Count > 2 && ds.Tables[2].Rows.Count > 0)
        {
            foreach (DataRow row in ds.Tables[2].Rows)
            {
                CargoBackModel_Exp cargo = new CargoBackModel_Exp
                {
                    messageType = "R",

                    sbNumber = GetValue(row, "ANNEX_AIR_JOBNO"),
                    sbDate = null,   // not available

                    natureOfCargo = GetValue(row, "NATURE_OF_CARGO"),
                    loosePacketsLeft = null,  // not available

                    totalPacketsLeft = GetValue(row, "ANNEX_AIR_TOTAL_PACKAGES"),
                    noOfContainersLeft = GetValue(row, "ANNEX_AIR_TOTAL_PACKAGES_MAWB"),

                    grossWeightLeft = GetValue(row, "ANNEX_AIR_GROSS_WEIGHT"),
                    netWeightLeft = GetValue(row, "ANNEX_AIR_NET_WEIGHT"),

                    uniqueQuantityCode = GetValue(row, "ANNEX_AIR_UNIT_CODE"),

                    amendmentType = null,
                    amendmentNumber = null,
                    amendmentDate = null
                };

                root.master_Exp.CargoBack.Add(cargo);
            }
        }


        
        root.master_Exp.AR4_model = NullIfEmpty(root.master_Exp.AR4_model);
        root.master_Exp.CessModel = NullIfEmpty(root.master_Exp.CessModel);
        root.master_Exp.ConstituentFinal = NullIfEmpty(root.master_Exp.ConstituentFinal);
        root.master_Exp.ContainerModel = NullIfEmpty(root.master_Exp.ContainerModel);
        root.master_Exp.ControlType = NullIfEmpty(root.master_Exp.ControlType);
        root.master_Exp.DfiaModel = NullIfEmpty(root.master_Exp.DfiaModel);
        root.master_Exp.EOUModel = NullIfEmpty(root.master_Exp.EOUModel);
        root.master_Exp.InfoType = NullIfEmpty(root.master_Exp.InfoType);
        root.master_Exp.InvoiceModel = NullIfEmpty(root.master_Exp.InvoiceModel);
        root.master_Exp.LicenseModel = NullIfEmpty(root.master_Exp.LicenseModel);
        root.master_Exp.ItemModel = NullIfEmpty(root.master_Exp.ItemModel);
        root.master_Exp.PackingListModel = NullIfEmpty(root.master_Exp.PackingListModel);
        root.master_Exp.Production = NullIfEmpty(root.master_Exp.Production);
        root.master_Exp.Reexport = NullIfEmpty(root.master_Exp.Reexport);
        root.master_Exp.Statement = NullIfEmpty(root.master_Exp.Statement);
        root.master_Exp.SupportingDocs = NullIfEmpty(root.master_Exp.SupportingDocs);
        root.master_Exp.ThirdPartyModel = NullIfEmpty(root.master_Exp.ThirdPartyModel);
        root.master_Exp.CargoBack = NullIfEmpty(root.master_Exp.CargoBack);



        // ================= SERIALIZE =================

        var settings = new JsonSerializerSettings
        {
            NullValueHandling = NullValueHandling.Ignore,
            DefaultValueHandling = DefaultValueHandling.Ignore
        };

        string json = JsonConvert.SerializeObject(
            root,
            Formatting.Indented,
            settings);

        File.WriteAllText(filePath, json);

    }
    private string GetValue(DataRow row, string columnName)
    {
        if (row.Table.Columns.Contains(columnName) &&
            row[columnName] != DBNull.Value)
        {
            string value = row[columnName].ToString().Trim();

            return string.IsNullOrEmpty(value) ? null : value;
        }

        return null;
    }
    private List<T> NullIfEmpty<T>(List<T> list)
    {
        return (list == null || list.Count == 0) ? null : list;
    }
}


