  <Code>
        Public Function NumberToWords(ByVal number As Long) As String
        Dim Units() As String = {"", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
        "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen",
        "Sixteen", "Seventeen", "Eighteen", "Nineteen"}

        Dim Tens() As String = {"", "", "Twenty", "Thirty", "Forty", "Fifty",
        "Sixty", "Seventy", "Eighty", "Ninety"}

        Dim words As String = ""

        If number &gt;= 100000 Then
        words &amp;= NumberToWords(number \ 100000) &amp; " Lakh "
        number = number Mod 100000
        End If

        If number &gt;= 1000 Then
        words &amp;= NumberToWords(number \ 1000) &amp; " Thousand "
        number = number Mod 1000
        End If

        If number &gt;= 100 Then
        words &amp;= NumberToWords(number \ 100) &amp; " Hundred "
        number = number Mod 100
        End If

        If number &gt; 0 Then
        If number &lt; 20 Then
        words &amp;= Units(number)
        Else
        words &amp;= Tens(number \ 10)
        If number Mod 10 &gt; 0 Then
        words &amp;= " " &amp; Units(number Mod 10)
        End If
        End If
        End If

        Return words.Trim()
        End Function

        Public Function AmountInWordsWithINR(ByVal amount As Decimal) As String
        If amount = 0 Then
        Return "In Words : INR Zero Only"
        End If

        Dim num As Long = Math.Floor(amount)
        Dim words As String = NumberToWords(num)

        Return "In Words : INR " &amp; words &amp; " Only"
        End Function
    </Code>
