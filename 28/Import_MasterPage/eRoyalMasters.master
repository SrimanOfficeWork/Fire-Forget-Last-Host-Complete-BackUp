    <style>
        body
        {
            font-family: Arial, sans-serif;
            padding: 50px;
            background: #f0f0f0;
        }
        .ad-wrapper
        {
            position: relative;
            display: inline-block;
            margin-left: -10px;
            left: 0px;
            width: 80px;
        }
        .menu-item
        {
            color: black;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        .ad-popup
        {
            display: none;
            position: absolute;
            top: 80%;
            right: 50%;
            background: white;
            box-shadow: 0 4px 10px rgb(114, 185, 150);
            border-radius: 8px;
            padding: 5px;
            z-index: 200;
            width: 500px;
            text-align: center;
        }
        .ad-popup img
        {
            width: 100%;
            height: auto; /* Adjusts height proportionally */
            max-height: none; /* Remove limitation */
            object-fit: contain;
            border-radius: 4px;
            cursor: zoom-in;
            display: block;
        }
        .nav-btn
        {
            margin: 5px;
            height: 25px;
            font-size: 14px;
            width: 55px;
            background: #f5f9f7;
            background-color: rgb(245, 249, 247);
            font: bold;
            box-shadow: blue;
            border-radius: 4px;
            transition: background-color 0.3s, color 0.3s;
            font-size: medium;
            box-shadow: 0 6px 5px rgba(83, 151, 191, 0.58);
            border-bottom: 1px solid #26272899;
            border-top: 1px solid #26272899;
            border-left: 1px solid #26272899;
            border-right: 1px solid #26272899;
            font-size: 15px;
            background-color: white;
            font-weight: bold;
        }
        /* Zoom overlay styles */.zoom-overlay
        {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.8);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            transition: opacity 0.3s ease;
        }
        .zoom-overlay.visible
        {
            display: flex;
            opacity: 1;
        }
        .zoom-overlay.closing
        {
            opacity: 0;
        }
        .zoom-overlay img
        {
            max-width: 90%;
            max-height: 90%;
            border-radius: 8px;
            transition: transform 0.3s ease;
            transform: scale(1);
        }
        .zoom-overlay.closing img
        {
            transform: scale(0.8);
        }
        .close-btn
        {
            position: absolute;
            top: 20px;
            right: -60px;
            font-size: 30px;
            color: white;
            cursor: pointer;
            margin-right: 360px;
        }
    </style>
    <style type="text/css">
        #Div2
        {
            overflow: visible !important;
        }
        .neon-button-wrapper
        {
            display: block;
            text-align: center;
            width: 100%;
            padding: 6px 0;
        }
        .neon-button
        {
            display: -webkit-inline-box;
            display: -ms-inline-flexbox;
            display: inline-flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            gap: 6px;
            padding: 10px 24px;
            background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 600;
            position: relative;
            box-shadow: 0 0 20px rgba(124, 58, 237, 0.6), 0 0 40px rgba(124, 58, 237, 0.4), 0 0 60px rgba(124, 58, 237, 0.25), 0 0 80px rgba(124, 58, 237, 0.15), inset 0 0 20px rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            border: 2px solid rgba(167, 139, 250, 0.5);
            overflow: hidden;
            cursor: pointer;
            margin: 4px 10px;
        }
        
        /* Shimmer/Transmission effect */
        .neon-button::before
        {
            content: '';
            position: absolute;
            top: -50%;
            left: -100%;
            width: 100%;
            height: 200%;
            background: linear-gradient(
                                            90deg,
                                            transparent,
                                            rgba(255, 255, 255, 0.3),
                                            rgba(255, 255, 255, 0.5),
                                            rgba(255, 255, 255, 0.3),
                                            transparent
                                        );
            -webkit-transform: skewX(-25deg);
            -ms-transform: skewX(-25deg);
            transform: skewX(-25deg);
            transition: left 0.7s ease;
            pointer-events: none;
        }
        
        .neon-button:hover::before
        {
            left: 150%;
        }
        
        /* Static glow on hover */
        .neon-button:hover
        {
            -webkit-transform: translateY(-2px);
            -ms-transform: translateY(-2px);
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(124, 58, 237, 0.9), 0 0 60px rgba(124, 58, 237, 0.6), 0 0 90px rgba(124, 58, 237, 0.4), 0 0 120px rgba(124, 58, 237, 0.2), inset 0 0 20px rgba(255, 255, 255, 0.2);
        }
        
        /* Sparkle styling */
        .neon-button .sparkle
        {
            -webkit-flex-shrink: 0;
            -ms-flex-negative: 0;
            flex-shrink: 0;
            -webkit-filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.8));
            filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.8));
            transition: all 0.3s ease;
            width: 14px;
            height: 14px;
        }
        
        .neon-button:hover .sparkle
        {
            -webkit-transform: scale(1.1);
            -ms-transform: scale(1.1);
            transform: scale(1.1);
            -webkit-filter: drop-shadow(0 0 8px rgba(255, 255, 255, 1));
            filter: drop-shadow(0 0 8px rgba(255, 255, 255, 1));
        }
        
        /* Active/Click state */
        .neon-button:active
        {
            -webkit-transform: translateY(0px);
            -ms-transform: translateY(0px);
            transform: translateY(0px);
            box-shadow: 0 0 15px rgba(124, 58, 237, 0.6), 0 0 30px rgba(124, 58, 237, 0.4), inset 0 0 15px rgba(255, 255, 255, 0.15);
        }
    </style>
    <style type="text/css">
    @keyframes bellRing {
        0%   { transform: rotate(0deg);   }
        10%  { transform: rotate(15deg);  }
        20%  { transform: rotate(-15deg); }
        30%  { transform: rotate(10deg);  }
        40%  { transform: rotate(-10deg); }
        50%  { transform: rotate(5deg);   }
        60%  { transform: rotate(-5deg);  }
        70%  { transform: rotate(0deg);   }
        100% { transform: rotate(0deg);   }
    }
</style>
