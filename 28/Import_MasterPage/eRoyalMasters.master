    <!-- VALIDATION SCRIPT -->
    <script type="text/javascript">

        var config = {
            '.chosen-select': {},
            '.chosen-select-deselect': { allow_single_deselect: true },
            '.chosen-select-no-single': { disable_search_threshold: 10 },
            '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-width': { width: "95%" }
        };


        for (var selector in config) {
            if (config.hasOwnProperty(selector)) {
                $(selector).chosen(config[selector]);
            };
        }
    </script>
    <script type="text/javascript">
document.addEventListener("DOMContentLoaded", function () {
    const ads = JSON.parse('<%= HttpUtility.JavaScriptStringEncode(hdAdsJson.Value) %>') || [];
    let current = 0;

    const menuItem = document.getElementById('menuItem');
    const adPopup = document.getElementById('adPopup');
    const adImg = document.getElementById('adImg');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    const zoomOverlay = document.getElementById('zoomOverlay');
    const zoomImg = document.getElementById('zoomImg');
    const closeZoomBtn = document.getElementById('closeZoom');

    function showAd(index) {
        current = index;
        adImg.src = ads[current] || "";
    }

    if (ads.length > 0) {
        showAd(current);
    }

    if (prevBtn) {
        prevBtn.onclick = () => {
            current = (current - 1 + ads.length) % ads.length;
            showAd(current);
        };
    }

    if (nextBtn) {
        nextBtn.onclick = () => {
            current = (current + 1) % ads.length;
            showAd(current);
        };
    }

    if (menuItem) {
        menuItem.addEventListener("mouseenter", () => {
            adPopup.style.display = "block";
        });
        menuItem.addEventListener("mouseleave", () => {
            setTimeout(() => {
                if (!adPopup.matches(':hover')) {
                    adPopup.style.display = "none";
                }
            }, 200);
        });
    }

    if (adPopup) {
        adPopup.addEventListener("mouseleave", () => {
            adPopup.style.display = "none";
        });
        adPopup.addEventListener("mouseenter", () => {
            adPopup.style.display = "block";
        });
    }

    if (adImg) {
        adImg.addEventListener('click', () => {
            zoomImg.src = ads[current] || "";
            zoomOverlay.classList.add('visible');
            zoomOverlay.classList.remove('closing');
        });
    }

    function closeZoom() {
        zoomOverlay.classList.add('closing');
        setTimeout(() => {
            zoomOverlay.classList.remove('visible');
            zoomOverlay.classList.remove('closing');
        }, 300);
    }

    if (closeZoomBtn) closeZoomBtn.addEventListener('click', closeZoom);

    if (zoomOverlay) {
        zoomOverlay.addEventListener('click', (e) => {
            if (e.target === zoomOverlay) {
                closeZoom();
            }
        });
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeZoom();
        }
    });
});
    </script>
    <script type="text/javascript">
        // On page load &#8212; highlight bell if image active
        document.addEventListener('DOMContentLoaded', function () {
            var imgPath = document.getElementById(
            'hdnBellImagePath').value;
            if (imgPath && imgPath !== '') {
                var dot = document.getElementById('spanBellDot');
                if (dot) dot.style.display = 'block';
                var bell = document.getElementById('spanBellIcon');
                if (bell) {
                    bell.style.animation = 'bellRing 1s infinite';
                }
            }
        });

        function OpenBellPopup() {
            var imgPath = document.getElementById(
            'hdnBellImagePath').value;
            var div = document.getElementById('divBellImagePopup');
            var img = document.getElementById('imgBellDisplay');
            var noImg = document.getElementById('divBellNoImage');

            if (imgPath && imgPath !== '') {
                img.src = imgPath;
                img.style.display = 'block';
                noImg.style.display = 'none';
            }
            else {
                img.style.display = 'none';
                noImg.style.display = 'block';
            }
            div.style.display = 'block';
        }

        function CloseBellPopup() {
            var div = document.getElementById('divBellImagePopup');
            var img = document.getElementById('imgBellDisplay');
            if (div) div.style.display = 'none';
            if (img) img.src = '';
        }
</script>
</body>
</html>
