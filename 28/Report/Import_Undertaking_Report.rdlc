                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>     I/We fail to observe the contents as mentioned in clause 3 here  </Value>
                              <Style>
                                <FontSize>8pt</FontSize>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>in above four withon demand by the Dy.Assessor &amp;.</Value>
