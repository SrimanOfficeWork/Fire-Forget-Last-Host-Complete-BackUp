<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <!-- Enable ASP.NET Core layout renderers (httpcontext, etc.) -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- ============================================================
       TARGETS — where logs get written
       ============================================================ -->
  <targets>

    <!-- All logs (Trace and above) — daily file -->
    <target xsi:type="File" name="allfile"
            fileName="${basedir}/logs/fireforget-all-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/logs/archive/fireforget-all-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- Docker Vision callbacks only — one line per received result, for tracing a job -->
    <target xsi:type="File" name="callbackFile"
            fileName="${basedir}/logs/fireforget-callback-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/logs/archive/fireforget-callback-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="60"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- Errors only — separate file for quick scanning -->
    <target xsi:type="File" name="errorFile"
            fileName="${basedir}/logs/fireforget-errors-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring,stacktrace}|url: ${aspnet-request-url}"
            archiveFileName="${basedir}/logs/archive/fireforget-errors-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="60"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- Console — visible while running via `dotnet run` / F5 -->
    <target xsi:type="Console" name="logconsole"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message} ${exception:format=tostring}" />

  </targets>

  <!-- ============================================================
       RULES — which logger goes to which target
       ============================================================ -->
  <rules>

    <!-- Kestrel's "Now listening on" lines stay on the console -->
    <logger name="Microsoft.Hosting.Lifetime"    minlevel="Info"  writeTo="logconsole" final="true" />

    <!-- Suppress noisy Microsoft framework logs below Warning -->
    <logger name="Microsoft.*"                  maxlevel="Info"  final="true" />
    <logger name="System.Net.Http.*"            maxlevel="Info"  final="true" />

    <!-- Callback routes (Program) → callback file -->
    <logger name="Program"                      minlevel="Info"  writeTo="callbackFile,allfile" final="true" />

    <!-- Errors (any logger) → errors file -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />

    <!-- Everything else → all file + console -->
    <logger name="*" minlevel="Trace" writeTo="allfile,logconsole" />

  </rules>
</nlog>
