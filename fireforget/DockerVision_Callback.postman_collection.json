            { "key": "CompanyID", "value": "ERI00001", "type": "text" },
            { "key": "ProcessId", "value": "{{processId}}", "type": "text" },
            { "key": "JobNo", "value": "JOB-0001", "type": "text" },
            { "key": "FileName", "value": "sample.pdf", "type": "text" },
            { "key": "UserID", "value": "ADMIN", "type": "text" },
            { "key": "BranchCode", "value": "MAIN", "type": "text" },
            { "key": "WorkingPeriod", "value": "2026-2027", "type": "text" },
            { "key": "JobType", "value": "IMP", "type": "text" },
            { "key": "PdfClientName", "value": "TIMKEN US", "type": "text" },
            { "key": "JsonResponse", "type": "file", "src": [] }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/callback/docker-vision/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "callback", "docker-vision", ""]
        },
        "description": "Expected: 202 Accepted with status READY or FAILED. 400 if a required field is missing, 401 if the API key is wrong, 422 if the JSON CompanyID does not match CompanyID."
